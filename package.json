{
	"name": "tgminiapp",
	"version": "1.0.0",
	"private": true,
	"description": "",
	"keywords": [],
	"license": "GNU3",
	"author": "therossdev",
	"scripts": {
		"build": "nest build",
		"dev": "nest start -b swc -w",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"migration:create": "typeorm-ts-node-commonjs migration:create src/database/migrations/${NAME:-migration}",
		"migration:generate": "pnpm run build && pnpm run typeorm migration:generate",
		"migration:revert": "pnpm run typeorm migration:revert",
		"migration:run": "pnpm run typeorm migration:run",
		"migration:show": "pnpm run typeorm migration:show",
		"start": "node dist/main.js",
		"start:debug": "nest start --debug --watch",
		"start:dev": "nest start",
		"test": "jest",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"test:watch": "jest --watch",
		"typeorm": "typeorm-ts-node-commonjs -d src/database/datasource.ts"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"dependencies": {
		"@blazity/nest-file-fastify": "^1.0.0",
		"@fastify/helmet": "^13.0.1",
		"@fastify/multipart": "^9.0.3",
		"@fastify/static": "^8.2.0",
		"@nest-lab/fastify-multer": "^1.3.0",
		"@nestjs/cache-manager": "^3.1.2",
		"@nestjs/common": "^11.0.0",
		"@nestjs/core": "^11.0.0",
		"@nestjs/platform-fastify": "^11.1.3",
		"argon2": "^0.43.0",
		"cache-manager": "^7.2.8",
		"dotenv": "^17.4.2",
		"helmet": "^8.1.0",
		"libsodium-wrappers": "^0.8.4",
		"multer": "2.0.0",
		"nestjs-i18n": "^10.8.4",
		"path-to-regexp": "^8.2.0",
		"pg": "^8.13.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.0.0",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.1049.0",
		"@changesets/cli": "^2.27.10",
		"@commitlint/cli": "^19.8.0",
		"@commitlint/config-conventional": "^19.6.0",
		"@nestjs-modules/mailer": "^2.0.2",
		"@nestjs/axios": "^4.0.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/config": "^4.0.0",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/swagger": "^11.0.0",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/testing": "^11.0.0",
		"@nestjs/throttler": "^6.3.0",
		"@nestjs/typeorm": "^11.0.0",
		"@swc/cli": "^0.7.0",
		"@swc/core": "^1.10.14",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/multer": "^1.4.12",
		"@types/node": "^25.9.0",
		"@types/supertest": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"axios": "^1.8.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"husky": "^9.1.7",
		"jest": "^30.0.0",
		"lint-staged": "^16.0.0",
		"nestjs-pino": "^4.1.0",
		"prettier": "^3.5.0",
		"prettier-plugin-css-order": "^2.1.2",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-packagejson": "^2.5.6",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
