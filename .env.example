# Proxy if packages are blocked
#
# Platform          Docker host
# Linux	            172.17.0.1 (default) or host.docker.internal with extra_hosts
# Mac	            host.docker.internal
# Windows	        host.docker.internal
# Linux (podman)	10.88.0.1
HTTP_PROXY=http://172.17.0.1:10808
HTTPS_PROXY=http://172.17.0.1:10808
NO_PROXY=localhost,127.0.0.1,.local,postgres
