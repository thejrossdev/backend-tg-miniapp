{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"typeCheck": true,
		"plugins": [
			{
				"name": "@nestjs/swagger",
				"options": {
					"dtoFileNameSuffix": [".dto.ts", ".entity.ts", "*.response.ts"],
					"introspectComments": true
				}
			}
		],
		"assets": [{ "include": "i18n/**/*", "watchAssets": true }]
	}
}
